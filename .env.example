# BFIntel — copy to .env and fill in (never commit .env)

# Core
BFINTEL_ENV=development
SECRET_KEY=change-me-use-openssl-rand-hex-32
FERNET_KEY=change-me-use-python-cryptography-fernet-generate-key

# Database
POSTGRES_USER=bfintel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bfintel
DATABASE_URL=postgresql+psycopg://bfintel:change-me@postgres:5432/bfintel

# Hardening (Phase 8)
# BF_RATE_LIMIT_ENABLED=true
# BF_LOGIN_RATE_LIMIT=10
# BF_API_RATE_LIMIT=300
# BF_TRUST_PROXY_HEADERS=false
# BF_DISABLE_API_DOCS=false

# Abuse report drafts (shown in generated ISP emails)
# BF_ABUSE_REPORTER_ORG=Your Organization SOC
# BF_ABUSE_REPORTER_EMAIL=soc@yourdomain.example
# BF_ABUSE_REPORTER_PHONE=

# Redis
REDIS_URL=redis://redis:6379/0

# UI entry (nginx). Use 8888 on lab if 8080 is taken (e.g. OpenCTI).
# BFINTEL_HTTP_PORT=8888

# Backend
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_COOKIE_SECURE=false

# Frontend (build-time)
# Leave empty for Docker/nginx (same-origin /api). For Vite dev only:
# VITE_API_BASE_URL=http://localhost:8000
VITE_API_BASE_URL=

# Wazuh (optional dev defaults — use setup wizard in production)
# WAZUH_API_URL=https://192.168.122.186:55000
# WAZUH_INDEXER_URL=https://127.0.0.1:9200

# Phase 2 — tail alerts.json from manager (host path mounted read-only into worker)
WAZUH_ALERTS_HOST_DIR=/var/ossec/logs/alerts
WAZUH_ALERTS_JSON_PATH=/wazuh-alerts/alerts.json
BF_CORRELATION_WINDOW_MINUTES=10
BF_ATTEMPT_THRESHOLD=5

# Phase 4 — IP enrichment (ip-api.com free tier; optional AbuseIPDB key)
BF_INTEL_ENRICHMENT_TTL_HOURS=168
BF_INTEL_IP_API_ENABLED=true
BF_INTEL_IP_API_BASE_URL=http://ip-api.com
ABUSEIPDB_API_KEY=
BF_INTEL_ABUSEIPDB_ENABLED=true
